        <mxCell id="bus_cl_h" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#7f5faf;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="424" as="sourcePoint" /><mxPoint x="1197" y="424" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="bus_cl_d" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="424" as="sourcePoint" /><mxPoint x="80" y="492" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="band_t" value="决策时序" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#8a97a3;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="442" width="130" height="18" as="geometry" /></mxCell>
        <mxCell id="t0" value="0:00 制定计划（288 槽）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="170" y="434" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="t1" value="6:00 调整 + 对冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="510" y="434" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="te1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="451" y="456" as="sourcePoint" /><mxPoint x="509" y="456" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t2" value="12:00 调整 + 对冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="850" y="434" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="te2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="791" y="456" as="sourcePoint" /><mxPoint x="849" y="456" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t3" value="18:00 调整" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1190" y="434" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="te3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1131" y="456" as="sourcePoint" /><mxPoint x="1189" y="456" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t4" value="24:00 日末 · SOC 跨日" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1530" y="434" width="280" height="44" as="geometry" /></mxCell>
        <mxCell id="te4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1471" y="456" as="sourcePoint" /><mxPoint x="1529" y="456" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="tnote" value="执行窗：相邻决策点间 6 h（问题二为 24 h）&lt;br&gt;逐槽因果执行 · 不读未来实际值 · free 无段末硬目标" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#666666;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1"><mxGeometry x="1840" y="434" width="530" height="44" as="geometry" /></mxCell>
        <mxCell id="q1_lbl" value="&lt;b&gt;问题一&lt;/b&gt;&lt;br&gt;完全信息" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.6;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="493" width="100" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_l0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="131" y="570" as="sourcePoint" /><mxPoint x="147" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c0" value="&lt;b&gt;信息集：完全信息&lt;/b&gt;&lt;br&gt;附件 1（典型日）&lt;br&gt;电价 · 负载 · 光伏预测&lt;br&gt;无预测误差" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="148" y="493" width="230" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_c1" value="&lt;b&gt;不做预测&lt;/b&gt;&lt;br&gt;完全信息直接优化&lt;br&gt;（作为后续各问的骨架与基准）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="396" y="493" width="300" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="379" y="570" as="sourcePoint" /><mxPoint x="395" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c2" value="&lt;b&gt;单日确定性 LP&lt;/b&gt;&lt;br&gt;min Σ p&lt;sub&gt;t&lt;/sub&gt;x&lt;sub&gt;t&lt;/sub&gt; + εΣ(c&lt;sub&gt;t&lt;/sub&gt;+q&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;s.t. P&lt;sub&gt;t&lt;/sub&gt; + x&lt;sub&gt;t&lt;/sub&gt; + q&lt;sub&gt;t&lt;/sub&gt; = L&lt;sub&gt;t&lt;/sub&gt; + c&lt;sub&gt;t&lt;/sub&gt; + s&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;E&lt;sub&gt;t&lt;/sub&gt; = E&lt;sub&gt;t−1&lt;/sub&gt; + ηc&lt;sub&gt;t&lt;/sub&gt; − q&lt;sub&gt;t&lt;/sub&gt;/η&lt;br&gt;1200 ≤ E ≤ 10800；0 ≤ c, q ≤ 5000/6&lt;br&gt;E&lt;sub&gt;0&lt;/sub&gt; = E&lt;sub&gt;144&lt;/sub&gt; = 6000；0 ≤ s ≤ P" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="714" y="493" width="320" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697" y="570" as="sourcePoint" /><mxPoint x="713" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c3" value="&lt;b&gt;无日内调整&lt;/b&gt;&lt;br&gt;确定性场景&lt;br&gt;无偏差结算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1052" y="493" width="490" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="570" as="sourcePoint" /><mxPoint x="1051" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c4" value="&lt;b&gt;执行 = 规划解&lt;/b&gt;&lt;br&gt;储能动作即最优解&lt;br&gt;无缺额、无弃光（本例）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1560" y="493" width="280" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#c08b5c;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1543" y="570" as="sourcePoint" /><mxPoint x="1559" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c5" value="&lt;b&gt;结算：计划购电费&lt;/b&gt;&lt;br&gt;C = Σ p&lt;sub&gt;t&lt;/sub&gt;x&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;结果：35126.95 元/日&lt;br&gt;基线 48048.6 元 → 省 26.9%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cfe0f5;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1858" y="493" width="250" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1841" y="570" as="sourcePoint" /><mxPoint x="1857" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q1_c6" value="&lt;b&gt;result1.xlsx&lt;/b&gt;&lt;br&gt;Q1_调度时序&lt;br&gt;Q1_储电量与电价&lt;br&gt;Q1_费用对比" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#bae2e4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="2126" y="493" width="238" height="155" as="geometry" /></mxCell>
        <mxCell id="q1_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2109" y="570" as="sourcePoint" /><mxPoint x="2125" y="570" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_lbl" value="&lt;b&gt;问题二&lt;/b&gt;&lt;br&gt;预测+执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.6;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="694" width="100" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_l0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="131" y="771" as="sourcePoint" /><mxPoint x="147" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c0" value="&lt;b&gt;信息集&lt;/b&gt;&lt;br&gt;附件 1 电价（每日相同）&lt;br&gt;附件 2 历史/实际 L、P&lt;br&gt;不使用附件 3 预报" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="148" y="694" width="230" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_c1" value="&lt;b&gt;历史自适应预测&lt;/b&gt;&lt;br&gt;L̂、P̂ 三源凸组合（见上）&lt;br&gt;权重按费用 EWMA h=5 逐日标定&lt;br&gt;修正：κL̂ 与 max(P̂ − m, 0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="396" y="694" width="300" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="379" y="771" as="sourcePoint" /><mxPoint x="395" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c2" value="&lt;b&gt;2 日滚动计划 LP&lt;/b&gt;&lt;br&gt;min Σ p&lt;sub&gt;t&lt;/sub&gt;x&lt;sub&gt;t&lt;/sub&gt; + εΣ(c + d)，288 槽&lt;br&gt;窗口末端自由 · E 跨日连续 · κ/m 输入&lt;br&gt;0:00 求解，只执行首日，次日重解" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="714" y="694" width="320" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697" y="771" as="sourcePoint" /><mxPoint x="713" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c3" value="&lt;b&gt;无日内调整&lt;/b&gt;&lt;br&gt;计划照付不议（take-or-pay）&lt;br&gt;偏差由 κ/m 裕度与 5× 紧急承担" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1052" y="694" width="490" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="771" as="sourcePoint" /><mxPoint x="1051" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c4" value="&lt;b&gt;逐槽因果执行&lt;/b&gt;&lt;br&gt;每槽只读当前已实现 L、P&lt;br&gt;储能吸收富余 / 覆盖缺口&lt;br&gt;缺口 → 5× 紧急 e；余量 → 弃光 s&lt;br&gt;free：无段末硬目标" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1560" y="694" width="280" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#c08b5c;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1543" y="771" as="sourcePoint" /><mxPoint x="1559" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c5" value="&lt;b&gt;结算&lt;/b&gt;&lt;br&gt;C = Σ p&lt;sub&gt;t&lt;/sub&gt;x&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;+ 5Σ p&lt;sub&gt;t&lt;/sub&gt;e&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cfe0f5;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1858" y="694" width="250" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1841" y="771" as="sourcePoint" /><mxPoint x="1857" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q2_c6" value="&lt;b&gt;result2.xlsx&lt;/b&gt;&lt;br&gt;蒙特卡洛 100 年&lt;br&gt;Q2E_权重演化 / 参数搜索&lt;br&gt;Q2_总费用分布" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#bae2e4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="2126" y="694" width="238" height="155" as="geometry" /></mxCell>
        <mxCell id="q2_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2109" y="771" as="sourcePoint" /><mxPoint x="2125" y="771" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane_dn_q2" value="递进" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.6;fontSize=13;fontColor=#7f5faf;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="649" as="sourcePoint" /><mxPoint x="80" y="693" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_lbl" value="&lt;b&gt;问题三&lt;/b&gt;&lt;br&gt;调整+对冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.6;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="895" width="100" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_l0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="131" y="972" as="sourcePoint" /><mxPoint x="147" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c0" value="&lt;b&gt;信息集&lt;/b&gt;&lt;br&gt;附件 2/3（0/6/12/18 预报）&lt;br&gt;白天 MAE：0:00 约 373 kW&lt;br&gt;13–18 时 MAE：413 → 76 kW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="148" y="895" width="230" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_c1" value="&lt;b&gt;组合预报&lt;/b&gt;&lt;br&gt;P̂mix = λf&lt;sub&gt;0&lt;/sub&gt; + (1−λ)P̂hist，λ = 0.7&lt;br&gt;6/12/18 用最新发布的组合预报&lt;br&gt;调整层与计划层必须同口径" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="396" y="895" width="300" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="379" y="972" as="sourcePoint" /><mxPoint x="395" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c2" value="&lt;b&gt;2 日滚动计划&lt;/b&gt;&lt;br&gt;同问题二：288 槽 · 末端自由&lt;br&gt;κ/m 裕度 + 组合预报；只执行首日" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="714" y="895" width="320" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697" y="972" as="sourcePoint" /><mxPoint x="713" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c3" value="&lt;b&gt;三点调整 + 场景对冲&lt;/b&gt;&lt;br&gt;6/12/18 用新预报重优化剩余时段&lt;br&gt;6/12 两阶段随机规划：&lt;br&gt;min Σ[1.5p x̂ − p y] + (1/S)Σ&lt;sub&gt;s&lt;/sub&gt;[ε(c+d) + 5p e&lt;sub&gt;s&lt;/sub&gt;]&lt;br&gt;y = min(x&lt;sup&gt;0&lt;/sup&gt;, x̂)；情景 = 名义 + 联合残差块&lt;br&gt;每情景 E&lt;sub&gt;144&lt;/sub&gt; = 计划日末值；S = 40" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1052" y="895" width="490" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="972" as="sourcePoint" /><mxPoint x="1051" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c4" value="&lt;b&gt;逐槽因果执行&lt;/b&gt;&lt;br&gt;free；每 6 h 窗只落地当期决策&lt;br&gt;段末 SOC 自由；缺口 5×" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1560" y="895" width="280" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#c08b5c;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1543" y="972" as="sourcePoint" /><mxPoint x="1559" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c5" value="&lt;b&gt;调整结算（final）&lt;/b&gt;&lt;br&gt;C = Σ p x&lt;sup&gt;a&lt;/sup&gt; + 0.5Σ p|x&lt;sup&gt;0&lt;/sup&gt; − x&lt;sup&gt;a&lt;/sup&gt;|&lt;br&gt;+ 5Σ p e&lt;br&gt;调低付 50% · 调高按 150%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cfe0f5;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1858" y="895" width="250" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1841" y="972" as="sourcePoint" /><mxPoint x="1857" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q3_c6" value="&lt;b&gt;result3.xlsx&lt;/b&gt;&lt;br&gt;消融（对冲/组合/调整）&lt;br&gt;Q3E_参数搜索&lt;br&gt;执行器策略对比" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#bae2e4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="2126" y="895" width="238" height="155" as="geometry" /></mxCell>
        <mxCell id="q3_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2109" y="972" as="sourcePoint" /><mxPoint x="2125" y="972" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane_dn_q3" value="递进" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.6;fontSize=13;fontColor=#7f5faf;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="850" as="sourcePoint" /><mxPoint x="80" y="894" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_lbl" value="&lt;b&gt;问题四&lt;/b&gt;&lt;br&gt;电价波动" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.6;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="1096" width="100" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_l0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#c08b5c;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="131" y="1173" as="sourcePoint" /><mxPoint x="147" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c0" value="&lt;b&gt;信息集&lt;/b&gt;&lt;br&gt;附件 2/3 + 附件 4 实时电价&lt;br&gt;G：当天电价已知（主口径）&lt;br&gt;H：仅历史价预测（信息扩展）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="148" y="1096" width="230" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_c1" value="&lt;b&gt;电价三源预测&lt;/b&gt;&lt;br&gt;p̂ = v&lt;sub&gt;1&lt;/sub&gt;p&lt;sub&gt;d−1&lt;/sub&gt; + v&lt;sub&gt;2&lt;/sub&gt;p&lt;sub&gt;d−7&lt;/sub&gt; + v&lt;sub&gt;3&lt;/sub&gt;p̄&lt;br&gt;v 按费用标定：W = 7 + β = 0.1&lt;br&gt;周周期：同星期几自相关 0.958" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="396" y="1096" width="300" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="379" y="1173" as="sourcePoint" /><mxPoint x="395" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c2" value="&lt;b&gt;双结构重算（同口径）&lt;/b&gt;&lt;br&gt;Q2 层：2 日滚动，同问题二构造&lt;br&gt;Q3 层：组合 + 三点 + 对冲，同问题三&lt;br&gt;电价换为附件 4；结算按真实价" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="714" y="1096" width="320" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697" y="1173" as="sourcePoint" /><mxPoint x="713" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c3" value="&lt;b&gt;调整层同问题三&lt;/b&gt;&lt;br&gt;G：用当天真实价决策与调整&lt;br&gt;H：用电价预测决策（仅历史信息）&lt;br&gt;信息价值 = C(H) − C(G)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1052" y="1096" width="490" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="1173" as="sourcePoint" /><mxPoint x="1051" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c4" value="&lt;b&gt;逐槽因果执行&lt;/b&gt;&lt;br&gt;free；按附件 4 真实价结算&lt;br&gt;储能在低价时段充电、高价放电" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1560" y="1096" width="280" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#c08b5c;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1543" y="1173" as="sourcePoint" /><mxPoint x="1559" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c5" value="&lt;b&gt;结算&lt;/b&gt;&lt;br&gt;Q2 层：Σ p&lt;sub&gt;4&lt;/sub&gt;x + 5Σ p&lt;sub&gt;4&lt;/sub&gt;e&lt;br&gt;Q3 层：同问题三（p → p&lt;sub&gt;4&lt;/sub&gt;）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cfe0f5;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1858" y="1096" width="250" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#3b547f;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1841" y="1173" as="sourcePoint" /><mxPoint x="1857" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="q4_c6" value="&lt;b&gt;result4-2 / 4-3&lt;/b&gt;&lt;br&gt;Q4_电价结构分解&lt;br&gt;Q4_电价权重演化&lt;br&gt;H/G 费用对比" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#bae2e4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="2126" y="1096" width="238" height="155" as="geometry" /></mxCell>
        <mxCell id="q4_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#4f8f8b;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2109" y="1173" as="sourcePoint" /><mxPoint x="2125" y="1173" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane_dn_q4" value="递进" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7f5faf;strokeWidth=1.6;fontSize=13;fontColor=#7f5faf;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1051" as="sourcePoint" /><mxPoint x="80" y="1095" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="band_e" value="验证与交付" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#8a97a3;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1272" width="300" height="18" as="geometry" /></mxCell>
        <mxCell id="e1" value="&lt;b&gt;时间留出验证协议&lt;/b&gt;&lt;br&gt;开发期 2–6 月：选 κ/m 与 EWMA 半衰期&lt;br&gt;冻结验证期 7–12 月：不参与任何选择&lt;br&gt;正式报告同时给出开发期与验证期结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="1292" width="572" height="110" as="geometry" /></mxCell>
        <mxCell id="e2" value="&lt;b&gt;风险量化（蒙特卡洛）&lt;/b&gt;&lt;br&gt;联合残差整日块重采样 · 100 年&lt;br&gt;输出：均值 / P95 / CVaR95&lt;br&gt;仅作事后风险评价，不参与在线决策" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="620" y="1292" width="572" height="110" as="geometry" /></mxCell>
        <mxCell id="e3" value="&lt;b&gt;机器 + 人工验证&lt;/b&gt;&lt;br&gt;因果执行回归测试 · 一致性守卫测试&lt;br&gt;五份结果文件结构审计（勾稽 / SOC / 日期）&lt;br&gt;关键算法逐行复核 + 固定随机种子" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1210" y="1292" width="572" height="110" as="geometry" /></mxCell>
        <mxCell id="e4" value="&lt;b&gt;无前视审计 + 交付&lt;/b&gt;&lt;br&gt;场景池 max(历史日) &lt; 目标日 · 违例 0 天&lt;br&gt;计划只用已发布预报；实际值仅回放与结算&lt;br&gt;交付：5 份 result + figures + RESULTS_REPORT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1800" y="1292" width="572" height="110" as="geometry" /></mxCell>
        <mxCell id="footer" value="注：L̂/P̂ 为预测，L/P 为实际；结果数值以 reports/RESULTS_REPORT.md 与 results/*.xlsx 最新重算为准；随机种子 42（蒙特卡洛）/ 7（对冲）。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#8a97a3;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1416" width="2340" height="22" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
