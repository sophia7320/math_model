<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" pages="1">
  <diagram id="model_onepager" name="模型一图流">
    <mxGraphModel dx="2400" dy="1460" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="微网购电–储能联合调控 模型一图流（CUMCM 2026 C 题）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1f3f6b;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="12" width="1280" height="34" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="四问递进 · 全程无前视因果 · 统一预测与风险机制 · 单一参数源 · 逐槽因果执行" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#666666;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="46" width="1540" height="20" as="geometry" /></mxCell>
        <mxCell id="band_b" value="数据与口径" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#8a97a3;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="400" height="18" as="geometry" /></mxCell>
        <mxCell id="b1" value="&lt;b&gt;附件 1 · 典型日&lt;/b&gt;&lt;br&gt;144 槽电价 p&lt;sub&gt;t&lt;/sub&gt;、负载、光伏预测&lt;br&gt;（附件 2/4 的全年逐槽均值）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="94" width="450" height="130" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;附件 2 · 全年实测&lt;/b&gt;&lt;br&gt;365 天负荷 L、光伏 P 实际值&lt;br&gt;（仅用于执行回放与结算真值）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="501" y="94" width="450" height="130" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;附件 3 · 光伏预报&lt;/b&gt;&lt;br&gt;365 天 × 0/6/12/18 发布&lt;br&gt;未来 24 整点 → 插值到 144 槽&lt;br&gt;（预报 k 小时 = 发布时刻 + k 小时）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="972" y="94" width="450" height="130" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;附件 4 · 实时电价&lt;/b&gt;&lt;br&gt;365 天 × 144 槽逐 10 分钟电价&lt;br&gt;（问题四按真实价结算）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1443" y="94" width="450" height="130" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;题面参数与口径&lt;/b&gt;&lt;br&gt;容量 12000 · 安全区 1200~10800 kWh&lt;br&gt;充放 5000 kW → 833.33 kWh/槽 · η = 0.9&lt;br&gt;E&lt;sub&gt;0&lt;/sub&gt; = 6000（2-1 起）· 缺口 5× 紧急 · 不售电&lt;br&gt;功率 ×1/6 → 电量 · 时间标签取右端点" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1914" y="94" width="450" height="130" as="geometry" /></mxCell>
        <mxCell id="band_c" value="统一预测与风险机制（四问共用）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#8a97a3;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="232" width="500" height="18" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;预测权重：按费用标定（无前视）&lt;/b&gt;&lt;br&gt;不按精度、按计划+紧急的实际费用选权重&lt;br&gt;M&lt;sub&gt;d&lt;/sub&gt; = γM&lt;sub&gt;d−1&lt;/sub&gt; + (1−γ)C&lt;sub&gt;d−1&lt;/sub&gt;，γ = 2&lt;sup&gt;−1/5&lt;/sup&gt;&lt;br&gt;(w, u)&lt;sub&gt;d&lt;/sub&gt; = argmin M&lt;sub&gt;d&lt;/sub&gt;，只用 ≤ d−1 的信息&lt;br&gt;C 表：21×21 权重网格 × 逐日费用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="30" y="254" width="572" height="150" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;三源凸组合（时变信任权重）&lt;/b&gt;&lt;br&gt;负荷 L̂ = w&lt;sub&gt;1&lt;/sub&gt;L&lt;sub&gt;d−7&lt;/sub&gt; + w&lt;sub&gt;2&lt;/sub&gt;L&lt;sub&gt;d−14&lt;/sub&gt; + w&lt;sub&gt;3&lt;/sub&gt;L̄&lt;br&gt;光伏 P̂ = u&lt;sub&gt;1&lt;/sub&gt;P&lt;sub&gt;d−1&lt;/sub&gt; + u&lt;sub&gt;2&lt;/sub&gt;P&lt;sub&gt;d−2&lt;/sub&gt; + u&lt;sub&gt;3&lt;/sub&gt;P̄&lt;br&gt;w, u ≥ 0 且 Σ = 1（softmax 参数化）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#7f5faf;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="620" y="254" width="572" height="150" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;风险裕度 κ / m（常量，时间留出选定）&lt;/b&gt;&lt;br&gt;κ = 1.015 负荷抬升 · m = 75 kW 光伏折减&lt;br&gt;依据：净需求残差 q80（报童临界比 1 − 1/5 = 0.8）&lt;br&gt;2–6 月开发期选择 · 7–12 月冻结验证" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1210" y="254" width="572" height="150" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;联合残差情景（问题三/四对冲用）&lt;/b&gt;&lt;br&gt;(Δ负荷, Δ光伏) 同月整日残差块重采样&lt;br&gt;保留日内相关与两通道相关性&lt;br&gt;池：j &lt; D；同月 ≥ 14 天，否则回看 90 天&lt;br&gt;S = 40 个等概率情景（各 1/S）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#4f8f8b;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="1800" y="254" width="572" height="150" as="geometry" /></mxCell>
        <mxCell id="bus_bc_v" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8a97a3;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1197" y="225" as="sourcePoint" /><mxPoint x="1197" y="233" as="targetPoint" /></mxGeometry></mxCell>
