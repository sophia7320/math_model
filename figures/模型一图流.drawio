        <mxCell id="bus_bc_3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#8a97a3;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2086" y="233" as="sourcePoint" /><mxPoint x="2086" y="253" as="targetPoint" /></mxGeometry></mxCell>
