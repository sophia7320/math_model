<mxfile host="app.diagrams.net" agent="opencode" version="24.7.17" pages="1">
<diagram id="q2flow" name="Q2改进模型流程">
<mxGraphModel dx="1220" dy="1500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1500" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="s1" value="&lt;b&gt;数据（每天 0:00 可用）&lt;/b&gt;&lt;br&gt;附件 1：电价 p_t、典型日负荷与光伏曲线&lt;br&gt;附件 2：历史实际 L、P（仅 ≤ d−1）；Q2 不用附件 3 预报" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="40" width="560" height="88" as="geometry" /></mxCell>
<mxCell id="s2" value="&lt;b&gt;预测层：三源组合&lt;/b&gt;&lt;br&gt;L^(t) = w₁·L(d−7) + w₂·L(d−14) + w₃·L_typ&lt;br&gt;P^(t) = u₁·P(d−1) + u₂·P(d−2) + u₃·P_typ&lt;br&gt;权重 (w, u) = softmax(θ)，非负、和为 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="168" width="560" height="158" as="geometry" /></mxCell>
<mxCell id="s3" value="&lt;b&gt;标定层：EWMA 选权 ★&lt;/b&gt;&lt;br&gt;费用表 C_k(w, u)：21×21 网格，按实际结算回算&lt;br&gt;M(d) = α·M(d−1) + (1−α)·C(d−1)，α = 2^(−1/5)&lt;br&gt;(w_d, u_d) = argmin M(d)（半衰期 5 天；只用 ≤ d−1）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="366" width="560" height="158" as="geometry" /></mxCell>
<mxCell id="s4" value="&lt;b&gt;决策修正：分布参考 → 裕度 ★&lt;/b&gt;&lt;br&gt;报童临界比 1 − 1/5 = 0.8 → 裕度 = 残差 q₀.₈&lt;br&gt;负荷抬升 κ = 1.02：L′ = κ·L^&lt;br&gt;光伏折扣 m = 50 kW：P′ = max(0, P^ − m)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="564" width="560" height="170" as="geometry" /></mxCell>
<mxCell id="s5" value="&lt;b&gt;计划层 LP（0:00 出计划）&lt;/b&gt;&lt;br&gt;min Σ p_t·x_t + ε·Σ(c_t + d_t)&lt;br&gt;s.t. P′/6 + x + d = L′/6 + c + s；E(0) = E(144) = 6000&lt;br&gt;计划购电 x 承诺买入（take-or-pay）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="774" width="560" height="150" as="geometry" /></mxCell>
<mxCell id="s6" value="&lt;b&gt;执行层：逐槽因果（不读未来实际）&lt;/b&gt;&lt;br&gt;实际揭晓后，每槽只按当前值与承诺 x 调度储能&lt;br&gt;将 SOC 投影到「仍能回到 6000」的可达区间&lt;br&gt;缺口 e → 5 倍紧急购电；富余 → 弃光" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="964" width="560" height="150" as="geometry" /></mxCell>
<mxCell id="s7" value="&lt;b&gt;结算&lt;/b&gt;&lt;br&gt;C_d = Σ p_t·x_t + 5·Σ p_t·e_t&lt;br&gt;全年费用 = Σ_d C_d" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="1154" width="560" height="110" as="geometry" /></mxCell>
<mxCell id="s8" value="&lt;b&gt;年度结果：1406.6 万元&lt;/b&gt;&lt;br&gt;对照官方 W=7：1467.4 万元（−4.14%）&lt;br&gt;分半验证 H1 −3.2% / H2 −5.0%；动态 κ 版 1417.7 万元" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#bae2e4;strokeColor=#4f8f8b;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="140" y="1304" width="1000" height="120" as="geometry" /></mxCell>
<mxCell id="legend" value="符号：L^ 预测、L′ 修正　|　★ 改进：EWMA 半衰期 5 天（原 7 天窗口均值）；新增 κ=1.02、m=50 kW 裕度" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#666666;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="1445" width="1060" height="30" as="geometry" /></mxCell>
<mxCell id="r1" value="&lt;b&gt;分布结构 → 参考值&lt;/b&gt;&lt;br&gt;残差 e = 实际净需求 − 预测净需求&lt;br&gt;q₀.₈(e) = 175 kW（全时段）；238 kW（白天）&lt;br&gt;κ_ref = 1 + q₀.₈(e / L^) ≈ 1.04&lt;br&gt;扫描落点 κ=1.02、m=50 kW（同量级）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#f3f0f7;strokeColor=#9b979f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=left;verticalAlign=middle;fontColor=#262626;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="400" height="200" as="geometry" /></mxCell>
<mxCell id="r2" value="&lt;b&gt;无前视保证与稳健性&lt;/b&gt;&lt;br&gt;标定、修正只用 ≤ d−1 的信息；执行逐槽因果&lt;br&gt;动态 κ：60 天滚动 q₀.₈ 自动重估 → 1417.7 万元&lt;br&gt;分半 H1 −3.2% / H2 −5.0%，跨期稳健" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#f3f0f7;strokeColor=#9b979f;strokeWidth=1.2;fontSize=16;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=left;verticalAlign=middle;fontColor=#262626;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="780" y="1000" width="400" height="190" as="geometry" /></mxCell>
