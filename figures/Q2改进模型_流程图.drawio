<mxCell id="loop" value="历史费用回填" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7b5530;strokeWidth=1.6;labelBackgroundColor=#ffffff;fontSize=16;fontColor=#7b5530;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="138" y="1209" as="sourcePoint" /><mxPoint x="138" y="445" as="targetPoint" /><Array as="points"><mxPoint x="80" y="1209" /><mxPoint x="80" y="445" /></Array></mxGeometry></mxCell>
